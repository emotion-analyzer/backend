# Model
CLASSIFICATION_MODEL_THRESHOLD=0.0
GENERATIVE_MODEL_THRESHOLD=0.30

# HuggingFace
HUGGINGFACE_REPO=emotionAnalyzer
# Loads the desired models in the analyzer, separated by a comma
# One or more of: all, es_classification, en_classification, es_generative, en_generative
# If all is used all others will be skipped
# Invalid models will be ignored
HUGGINGFACE_MODELS=es_classification

# FLUENTD
FLUENTD_HOST=fluentd
FLUENTD_PORT=24224

# ElasticSearch
ELASTICSEARCH_USER=analyzer
ELASTICSEARCH_PASSWORD=analyzer
ELASTICSEARCH_ADDRESS=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_BATCH_SIZE=500
ELASTICSEARCH_FLUSH_INTERVAL=0.5